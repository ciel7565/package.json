# =============================================================================
# 전통발효체험관 메타버스 — Apache rules for the installation folder (XAMPP: htdocs/metaverse)
# Requires AllowOverride All (XAMPP default for htdocs). CONTRACT §15.7 #2 #5 #11 #19.
#   - PHP endpoints send their own security headers; the Header rules here add the set to STATIC files and to the small
#     static error pages, and never touch a PHP response (so nothing is doubled).
#   - scanner bait (dot-files/folders, wp-*, phpmyadmin, config.php.bak …) is rewritten to api/trap.php, a logged
#     honeypot that answers a plain 404. Ordinary leftovers (*.sql *.log *.md *.ini backups archives editor copies …)
#     are denied with 403. The two sets do not overlap, so neither pre-empts the other.
#   - HTTPS is forced for a public host (localhost left alone); directory listing is off; ETags off.
#   The Server version banner and TRACE cannot be changed from .htaccess — set "ServerTokens Prod" and "TraceEnable Off"
#   in httpd.conf (health / 점검 reminds the operator). Upload size caps live in .user.ini + LimitRequestBody below.
# =============================================================================

Options -Indexes -MultiViews -Includes
DirectoryIndex index.html
AddDefaultCharset UTF-8
ServerSignature Off
FileETag None
LimitRequestBody 8388608

# PHP upload limits for mod_php (XAMPP runs PHP as an Apache module, and mod_php never reads .user.ini — that file is
# for PHP-FPM / CGI). The same values as .user.ini; inside IfModule, so a server without mod_php skips the block (a bare
# php_value there would be an error). Needs AllowOverride Options, like the Options line above (XAMPP: All).
<IfModule mod_php7.c>
  php_value upload_max_filesize 6M
  php_value post_max_size 8M
  php_value max_file_uploads 2
</IfModule>
<IfModule mod_php.c>
  php_value upload_max_filesize 6M
  php_value post_max_size 8M
  php_value max_file_uploads 2
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType model/gltf-binary .glb
  AddType font/woff2 .woff2
</IfModule>

# small static error pages (carry the static headers below; no server signature). An ErrorDocument path is counted
# from the web root, so a fixed "/e404.html" misses the pages of an installation in a sub-folder (XAMPP: htdocs/metaverse
# → /metaverse/e404.html). TFM_BASEREL is the installation's folder ("" at the web root, "metaverse/" there), found by
# the first rewrite rule below (Apache 2.4.13+ reads the line as an expression). Apache checks the access rules (the 403s
# of private folders and leftovers) BEFORE rewriting, so this earlier line already names a one-level folder whose
# e403.html is really there (htdocs/metaverse); where neither ran (no mod_setenvif / mod_rewrite) it is "/e403.html".
<IfModule mod_setenvif.c>
  SetEnvIfExpr "%{REQUEST_URI} =~ m#^/([^/]+/)# && -f '%{DOCUMENT_ROOT}/$1e403.html'" TFM_BASEREL=$1
  # the precompressed copies of the page (CONTRACT §16.9, below) are never compressed a second time by a server that
  # compresses text/html on its own (mod_deflate / mod_brotli read these two names)
  SetEnvIfNoCase Request_URI "/index\.(br|gz)\.html$" no-gzip no-brotli
</IfModule>
ErrorDocument 403 /%{reqenv:TFM_BASEREL}e403.html
ErrorDocument 404 /%{reqenv:TFM_BASEREL}e404.html

# ---------------------------------------------------------------- scanner bait → the honeypot (api/trap.php: 404 + log)
# A real visitor never asks for these. Runs before the HTTPS redirect so a probe is trapped even over plain http.
# Relative target, so a sub-folder install (…/metaverse/) works too. NOTE: these patterns never match a leftover that
# the FilesMatch below denies (dot-files and *.bak are handled only here), so the deny never pre-empts the trap.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # the installation's folder for the error pages above: REQUEST_URI minus the path below this folder (no rewrite)
  RewriteCond %{REQUEST_URI}::$1 ^/(.*?)(.*)::\2$
  RewriteRule ^(.*)$ - [E=TFM_BASEREL:%1]
  # TRACE / TRACK — best-effort refusal (the real switch is TraceEnable Off in httpd.conf)
  RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK)$ [NC]
  RewriteRule ^ - [F]
  # dot-files and dot-folders (.git/ .svn/ .hg/ .env .htaccess .user.ini .aws/ …), except .well-known
  RewriteRule "(^|/)\.(?!well-known/)" api/trap.php [L,NC]
  # classic scanner bait paths and the one backup name scanners always try
  RewriteRule "(^|/)(wp-login\.php|wp-admin|wp-includes|wp-content|xmlrpc\.php|phpmyadmin|phpmyadm|mysqladmin|server-status|server-info|vendor/phpunit|config\.php\.bak)(/|$)" api/trap.php [L,NC]
  RewriteRule "\.bak$" api/trap.php [L,NC]

  # ------------------------------------------------------------- force HTTPS (CONTRACT §15.7 #2)
  # A public host over plain http (or http reported by a proxy) is sent to https (permanent); localhost / 127.0.0.1 keep
  # working over http (a certificate-less internal network install). Static files are redirected too.
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteCond %{HTTP:X-Forwarded-Ssl} !on [NC]
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|\[?::1\]?)(:[0-9]+)?$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=308,L,E=TFM_NOAPP:1]

  # ------------------------------------------------------------- precompressed copies of the page (CONTRACT §16.9)
  # tools/build.mjs writes index.br.html and index.gz.html next to index.html (about a quarter of its size). A browser
  # that says it accepts the encoding ("br" is offered over https only; ";q=0" means no) gets the small file. The header
  # rules below name its Content-Encoding and add "Vary: Accept-Encoding" to all three files; each keeps its own
  # Last-Modified, so "not changed" (304) still works. Only where mod_headers can say what the bytes are, and only when
  # the copy is there. The server checks once an hour that the copies belong to this index.html (data/page.json) and
  # removes one that does not — after replacing index.html by hand, delete the two copies or build again.
  <IfModule mod_headers.c>
    RewriteCond %{HTTP:Accept-Encoding} "(^|[,\s])br\s*(,|$|;(?!\s*q=0(\.0*)?\s*(,|$)))" [NC]
    RewriteCond %{REQUEST_FILENAME} "^(.*?)(index\.html)?$"
    RewriteCond "%1index.br.html" -f
    RewriteRule "^(index\.html)?$" index.br.html [L]
    RewriteCond %{HTTP:Accept-Encoding} "(^|[,\s])(x-)?gzip\s*(,|$|;(?!\s*q=0(\.0*)?\s*(,|$)))" [NC]
    RewriteCond %{REQUEST_FILENAME} "^(.*?)(index\.html)?$"
    RewriteCond "%1index.gz.html" -f
    RewriteRule "^(index\.html)?$" index.gz.html [L]
  </IfModule>

  # ------------------------------------------------------------- the admin folder without its trailing slash (§15.4 b)
  # A folder asked for without its slash whose own index.php is there is handed to that index.php. Only the admin folder
  # (any name) sets "DirectorySlash Off" in its .htaccess; everywhere else mod_dir's 301 still answers first. The admin
  # entry checks security.admin_ip_allowlist BEFORE it sends the visitor on to "…/": a refused address gets the same 404
  # as a missing page instead of a redirect that shows the folder exists. Here, not in the admin folder's .htaccess: a
  # RewriteEngine there would switch the rules above off for the whole folder.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.php -f
  RewriteRule ^([^/]+)$ %{REQUEST_URI}/index.php [L]
</IfModule>

# ---------------------------------------------------------------- leftovers → denied (403). Not dot-files, not *.bak.
# error_log is the file PHP writes next to a script when log_errors is on without an error_log path (XAMPP / shared
# hosting): it holds paths, SQL and visitors' data. Thumbs.db is covered by \.db (.DS_Store is a dot-file: the trap).
<FilesMatch "(?i)(\.(sqlite3?|sqlite-wal|sqlite-shm|db|sql|log|md|ini|old|orig|swp|swo|save|lock|dist|sh|bat|ps1|yml|yaml|tmp|zip|tar|tgz|gz|bz2|xz|7z|rar)|~)$|^config\.local\.php$|^composer\.(json|lock)$|^package(-lock)?\.json$|^error_log$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ---------------------------------------------------------------- security headers (STATIC + error pages only)
<IfModule mod_headers.c>
  Header always unset X-Powered-By
  # non-HTML static assets (css, js, fonts, models, media, json): the full set + a default-src 'none' CSP. Images are
  # handled by the block below (and uploads/.htaccess owns the uploaded ones). These never match a .php response, so a
  # PHP endpoint keeps exactly its own headers.
  <FilesMatch "(?i)\.(js|css|woff2?|ttf|otf|glb|gltf|bin|txt|mp3|ogg|wav|mp4|json|map)$">
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set Permissions-Policy "camera=(), microphone=(self), geolocation=(), payment=(), usb=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    Header always set X-Frame-Options "DENY"
    Header always set Content-Security-Policy "default-src 'none'"
  </FilesMatch>
  # images: the same set but WITHOUT a CSP here — a Files-scoped CSP at the root would override the stricter
  # uploads/.htaccess CSP (sandbox, img-src 'self') on uploaded photos. (The app's own images live in the page.)
  <FilesMatch "(?i)\.(png|jpe?g|webp|gif|svg|ico)$">
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set Permissions-Policy "camera=(), microphone=(self), geolocation=(), payment=(), usb=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    Header always set X-Frame-Options "DENY"
  </FilesMatch>
  # HTML carries its own strict <meta> CSP; the header only adds frame-ancestors (never default-src 'none', which would
  # fight the page's own policy). This also covers the static error pages (e403.html / e404.html).
  <FilesMatch "(?i)\.html?$">
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set Permissions-Policy "camera=(), microphone=(self), geolocation=(), payment=(), usb=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Content-Security-Policy "frame-ancestors 'self'"
    Header always set Cache-Control "no-cache"
  </FilesMatch>
  # the precompressed copies of the page (CONTRACT §16.9, see the rewrite rules above): what the bytes are — on an answer
  # that carries the file only, never on an error page — and that the answer depends on the browser's Accept-Encoding,
  # also for the plain page, so a cache in between keeps the three apart
  <FilesMatch "(?i)^index\.br\.html$">
    Header set Content-Encoding "br"
  </FilesMatch>
  <FilesMatch "(?i)^index\.gz\.html$">
    Header set Content-Encoding "gzip"
  </FilesMatch>
  <FilesMatch "(?i)^index(\.br|\.gz)?\.html$">
    Header merge Vary "Accept-Encoding"
  </FilesMatch>
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"

  # Apache answers that never reach PHP (the HTTPS redirect, a LimitRequestBody / error page, a TRACE echo) still carry a
  # strict CSP + nosniff. Scoped so an ordinary PHP or static HTML response is untouched (no doubled header on those):
  #   · the HTTPS redirect (env set on the RewriteRule) · any 4xx/5xx status · a TRACE request.
  Header always set Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'" env=TFM_NOAPP
  Header always set X-Content-Type-Options "nosniff" env=TFM_NOAPP
  Header always set Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'" "expr=%{REQUEST_STATUS} >= 400"
  Header always set Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'" "expr=%{REQUEST_METHOD} =~ /^(TRACE|TRACK)$/"
</IfModule>
