# =============================================================================
# 전통발효체험관 메타버스 — 관리자 센터 폴더의 Apache 규칙 (CONTRACT §15.4)
# XAMPP 기본 설정(AllowOverride All)에서 동작해요. 이 파일에는 폴더 이름이 적혀 있지 않아서, 폴더 이름을 바꿔도
# (php cli/tfm.php admin:path --random) 그대로 동작해요.
#   - 파일 목록 보기는 꺼져 있고, 이 폴더의 첫 화면은 index.php 예요.
#   - 열리는 파일은 index.php(관리자 화면) 하나뿐이에요. 화면 모양 파일은 lib/admin.css 에 있고, index.php 가 접속
#     허용 주소(security.admin_ip_allowlist)를 먼저 확인한 다음에 보내 줘요. 나머지 파일은 모두 막혀요(403).
#   - 아래 "추가 잠금" 두 가지는 처음에는 꺼져 있어요. 그 줄 맨 앞의 # 을 지우면 켜져요.
# =============================================================================

Options -Indexes -MultiViews
DirectoryIndex index.php

# 관리자 화면이 이 파일이 적용됐는지 알 수 있게 표시해 둬요 (시스템 점검 → 웹 서버).
<IfModule mod_env.c>
  SetEnv TFM_ADMIN_HTACCESS 1
</IfModule>

# 주소 끝에 / 없이 폴더만 적었을 때(…/admin): Apache 가 스스로 "…/admin/ 으로 가세요"(301)라고 답하지 않게 해요.
# 그 답은 PHP 보다 먼저 나가서, 허용 주소가 아닌 곳에도 "여기 관리자 폴더가 있어요"라고 알려 주거든요. 대신 설치
# 폴더의 .htaccess 가 이 요청을 index.php 로 넘기고, index.php 가 주소를 확인한 다음에 …/admin/ 으로 보내 줘요.
# (mod_rewrite 가 없는 서버에서는 이 줄이 꺼져 있어서 예전처럼 Apache 가 301 로 답해요.)
<IfModule mod_rewrite.c>
  DirectorySlash Off
</IfModule>

# index.php 가 아닌 파일은 모두 막아요 (편집기가 남긴 사본, 메모, 다른 스크립트 …).
# (폴더 자체는 막지 않아요: 폴더 이름은 마음대로 바뀌니까 "파일이면 index.php 하나만"으로 정했어요. Apache 2.4 의
# <If> 를 써요. admin.css 는 아래 규칙이 "없는 페이지(404)"로 답하도록 여기서는 빼 두었어요.)
<If "-f %{REQUEST_FILENAME} && %{REQUEST_FILENAME} !~ m#/(index\.php|admin\.css)$#">
  Require all denied
</If>

# 예전 버전이 남긴 admin.css: 새 버전을 덮어 올려도 옛 파일은 그대로 남아요. 그 파일이 있어도 "없는 페이지(404)"와
# 똑같이 답하고 내용은 보여 주지 않아요. 시스템 점검(🩺)이 지워도 되는 파일이라고 알려 줘요.
<IfModule mod_alias.c>
  RedirectMatch 404 "(?i)/admin\.css$"
</IfModule>
<IfModule !mod_alias.c>
  <Files "admin.css">
    Require all denied
  </Files>
</IfModule>

# ---------------------------------------------------------------- 추가 잠금 ① 정해진 곳에서만 열기 (주소 허용 목록)
# 관리자가 일하는 곳의 인터넷 주소에서만 이 폴더가 열려요. 아래 한 줄의 맨 앞 # 을 지우고 주소를 바꾸세요.
# 주소 여러 개는 띄어서 적고, 범위는 192.168.0.0/24 처럼 적어요. 다른 곳에서는 "접근 금지(403)"가 보여요.
# (설정 파일의 security.admin_ip_allowlist 와 함께 써도 돼요 — 그쪽은 "없는 페이지(404)"로 보여 줘요.)
# Require ip 203.0.113.7 192.168.0.0/24

# ---------------------------------------------------------------- 추가 잠금 ② 문 앞에서 비밀번호 한 번 더 (Basic 인증)
# 관리자 로그인 화면이 나오기 전에 브라우저가 이름과 비밀번호를 먼저 물어요.
# 1) 비밀번호 파일을 웹 폴더(htdocs) 바깥에 만들어요. XAMPP Control Panel 의 Shell 에서:
#      C:\xampp\apache\bin\htpasswd.exe -c -B C:\xampp\security\tfm-admin.htpasswd 이름
# 2) 아래 네 줄의 맨 앞 # 을 지우고, AuthUserFile 뒤의 경로를 1) 에서 만든 파일로 바꿔요. 그리고 Apache 를 다시 켤 필요는 없어요.
# AuthType Basic
# AuthName "Admin"
# AuthUserFile "C:/xampp/security/tfm-admin.htpasswd"
# Require valid-user
